<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CrowCast.ControlPlane.Client</PackageId>
    <Title>CrowCast Control Plane Client</Title>
    <Description>Non-blocking gRPC observation reporter for CrowCast replicas.</Description>
    <PackageTags>$(PackageTags);grpc;telemetry;control-plane</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CrowCast.Tests" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <ProjectReference Include="..\CrowCast.ControlPlane.Protocol\CrowCast.ControlPlane.Protocol.csproj" />
    <ProjectReference Include="..\CrowCast.Observability\CrowCast.Observability.csproj" />
  </ItemGroup>
</Project>
