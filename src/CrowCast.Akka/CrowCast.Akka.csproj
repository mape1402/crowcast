<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CrowCast.Akka</PackageId>
    <Title>CrowCast Akka.NET Backend</Title>
    <PackageType>Dependency</PackageType>
    <Description>Akka.NET Cluster and Distributed PubSub backend for CrowCast.</Description>
    <PackageTags>$(PackageTags);akka;gossip;cluster;distributed-pubsub</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrowCast.Tests" />
    <PackageReference Include="Akka.Cluster" Version="1.5.75" />
    <PackageReference Include="Akka.Cluster.Tools" Version="1.5.75" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <ProjectReference Include="..\CrowCast\CrowCast.csproj" />
  </ItemGroup>

</Project>
